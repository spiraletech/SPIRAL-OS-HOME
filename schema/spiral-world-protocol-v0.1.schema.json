{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spiraletech.dev/schema/spiral-world-protocol-v0.1.schema.json",
  "title": "Spiral World Protocol v0.1",
  "oneOf": [
    { "$ref": "#/$defs/command" },
    { "$ref": "#/$defs/delta" },
    { "$ref": "#/$defs/event" },
    { "$ref": "#/$defs/transaction" },
    { "$ref": "spiral-world-state-v0.1.schema.json" }
  ],
  "$defs": {
    "stableId": {
      "type": "string",
      "minLength": 1
    },
    "causalBase": {
      "type": "object",
      "required": ["schema_version", "world_id", "epoch"],
      "properties": {
        "schema_version": { "const": "0.1" },
        "world_id": { "$ref": "#/$defs/stableId" },
        "epoch": { "type": "integer", "minimum": 0 }
      }
    },
    "command": {
      "allOf": [
        { "$ref": "#/$defs/causalBase" },
        {
          "type": "object",
          "required": ["message_type", "command_id", "issued_at_tick", "requester", "command_type", "payload"],
          "properties": {
            "message_type": { "const": "command" },
            "command_id": { "$ref": "#/$defs/stableId" },
            "issued_at_tick": { "type": "integer", "minimum": 0 },
            "requester": { "$ref": "#/$defs/stableId" },
            "command_type": { "type": "string", "minLength": 1 },
            "payload": {},
            "requested_transaction_id": { "type": ["string", "null"] }
          },
          "additionalProperties": true
        }
      ]
    },
    "componentChange": {
      "type": "object",
      "required": ["entity_id", "component_type", "previous_revision", "new_revision", "operation"],
      "properties": {
        "entity_id": { "$ref": "#/$defs/stableId" },
        "component_type": { "type": "string", "minLength": 1 },
        "previous_revision": { "type": "integer", "minimum": 0 },
        "new_revision": { "type": "integer", "minimum": 0 },
        "operation": { "enum": ["add", "replace", "remove"] },
        "payload": {}
      },
      "additionalProperties": true
    },
    "delta": {
      "allOf": [
        { "$ref": "#/$defs/causalBase" },
        {
          "type": "object",
          "required": ["message_type", "delta_id", "transaction_id", "authority_id", "base_tick", "commit_tick", "sequence", "changes"],
          "properties": {
            "message_type": { "const": "delta" },
            "delta_id": { "$ref": "#/$defs/stableId" },
            "command_id": { "type": ["string", "null"] },
            "transaction_id": { "$ref": "#/$defs/stableId" },
            "authority_id": { "$ref": "#/$defs/stableId" },
            "base_tick": { "type": "integer", "minimum": 0 },
            "commit_tick": { "type": "integer", "minimum": 0 },
            "sequence": { "type": "integer", "minimum": 0 },
            "changes": {
              "type": "array",
              "minItems": 1,
              "items": { "$ref": "#/$defs/componentChange" }
            }
          },
          "additionalProperties": true
        }
      ]
    },
    "event": {
      "allOf": [
        { "$ref": "#/$defs/causalBase" },
        {
          "type": "object",
          "required": ["message_type", "event_id", "transaction_id", "authority_id", "tick", "sequence", "event_type", "payload"],
          "properties": {
            "message_type": { "const": "event" },
            "event_id": { "$ref": "#/$defs/stableId" },
            "command_id": { "type": ["string", "null"] },
            "transaction_id": { "$ref": "#/$defs/stableId" },
            "authority_id": { "$ref": "#/$defs/stableId" },
            "tick": { "type": "integer", "minimum": 0 },
            "sequence": { "type": "integer", "minimum": 0 },
            "event_type": { "type": "string", "minLength": 1 },
            "payload": {}
          },
          "additionalProperties": true
        }
      ]
    },
    "transaction": {
      "allOf": [
        { "$ref": "#/$defs/causalBase" },
        {
          "type": "object",
          "required": ["message_type", "transaction_id", "base_tick", "commit_tick", "first_sequence", "last_sequence", "committer", "delta_ids", "event_ids"],
          "properties": {
            "message_type": { "const": "transaction" },
            "transaction_id": { "$ref": "#/$defs/stableId" },
            "command_id": { "type": ["string", "null"] },
            "base_tick": { "type": "integer", "minimum": 0 },
            "commit_tick": { "type": "integer", "minimum": 0 },
            "first_sequence": { "type": "integer", "minimum": 0 },
            "last_sequence": { "type": "integer", "minimum": 0 },
            "committer": { "$ref": "#/$defs/stableId" },
            "delta_ids": {
              "type": "array",
              "items": { "$ref": "#/$defs/stableId" }
            },
            "event_ids": {
              "type": "array",
              "items": { "$ref": "#/$defs/stableId" }
            }
          },
          "additionalProperties": true
        }
      ]
    }
  }
}
